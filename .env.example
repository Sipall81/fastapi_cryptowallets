# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Файл .env в git не попадает. Реальные секреты сюда НЕ писать.

# JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ключ шифрования приватных ключей кошельков (Fernet, 44 символа).
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при смене ключа уже сохранённые кошельки перестанут расшифровываться.
ENCRYPTION_KEY=change-me

# Инфраструктура (имена хостов — сервисы из docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/users
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:change-me@rabbitmq:5672/

# CoinGecko (ключ получить в личном кабинете CoinGecko)
COINGECKO_API_KEY=change-me
COINGECKO_URL=https://api.coingecko.com/api/v3

# Куки (для http в разработке COOKIE_SECURE=false, в проде true)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax